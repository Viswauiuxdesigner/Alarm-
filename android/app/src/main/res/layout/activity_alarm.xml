<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#0F172A">

    <TextView
        android:id="@+id/alarm_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚶"
        android:textSize="72sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Walking"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/alarm_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shared Reminder Alert"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btn_alarm_going"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="✅ I'm Going"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#10B981"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_alarm_skip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="❌ Skip Today"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#EF4444"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_alarm_snooze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="⏰ Snooze 10m"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4F46E5" />

</LinearLayout>
